#!/bin/bash
set -e

case "$1" in
  gen)
    [ -d build ] || cmake -S . -B build
    cmake --build build -j
    ./build/main include/main.cmnd
    ;;
  ana)
    root -l -b -q macros/analysis.C
    ;;
  plot)
    root -l -b -q macros/draw_plots.C
    ;;
  all|"")
    "$0" gen
    "$0" ana
    "$0" plot
    ;;
  *)
    echo "uzycie: $0 [gen|ana|plot|all]"
    exit 1
    ;;
esac
