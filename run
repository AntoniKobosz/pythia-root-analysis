#!/bin/bash
set -e

case "$1" in
  gen)
    cmake --build build -j
    ./build/zadanieRekrutacyjne include/main.cmnd
    ;;
  ana)
    root -l -b -q analysis.C
    ;;
  plot)
    root -l -b -q draw_plots.C
    ;;
  all|"")
    "$0" gen
    "$0" ana
    "$0" plot
    ;;
  *)
    echo "uzycie: $0 [gen|ana|plot|all]"
    exit 1
    ;;
esac
